<div
    id="cookie-consent"
    class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl md:left-1/2 md:right-auto md:w-[calc(100%-2rem)] md:-translate-x-1/2 dark:border-slate-700 dark:bg-slate-800"
    role="dialog"
    aria-labelledby="cookie-consent-title"
    aria-describedby="cookie-consent-text"
>
    <h2
        id="cookie-consent-title"
        class="text-lg font-bold text-slate-900 dark:text-white"
    >
        Datenschutz-Einstellungen
    </h2>

    <p
        id="cookie-consent-text"
        class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300"
    >
        Wir verwenden notwendige Technologien für den Betrieb der Website.
        Optionale Analyse-Technologien verwenden wir nur mit deiner Zustimmung.
        Weitere Informationen findest du in unserer
        <a
            href="/datenschutz"
            class="font-semibold text-blue-600 underline dark:text-blue-400"
        >
            Datenschutzerklärung
        </a>.
    </p>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button
            id="consent-reject"
            type="button"
            class="rounded-xl border border-slate-300 px-5 py-3 font-semibold text-slate-800 transition hover:bg-slate-100 dark:border-slate-600 dark:text-white dark:hover:bg-slate-700"
        >
            Nur notwendige
        </button>

        <button
            id="consent-accept"
            type="button"
            class="rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-700"
        >
            Alle akzeptieren
        </button>
    </div>
</div>

<button
    id="consent-settings"
    type="button"
    class="fixed bottom-4 left-4 z-40 rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-lg transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
>
    Cookie-Einstellungen
</button>

<script is:inline>
    (() => {
        const STORAGE_KEY = "fitandtravel-consent";

        const banner = document.getElementById("cookie-consent");
        const acceptButton = document.getElementById("consent-accept");
        const rejectButton = document.getElementById("consent-reject");
        const settingsButton = document.getElementById("consent-settings");

        if (!banner || !acceptButton || !rejectButton || !settingsButton) {
            return;
        }

        const showBanner = () => {
            banner.classList.remove("hidden");
        };

        const hideBanner = () => {
            banner.classList.add("hidden");
        };

        const saveConsent = (analytics) => {
            const consent = {
                necessary: true,
                analytics,
            };

            localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));

            hideBanner();

            if (
                analytics === true &&
                typeof window.loadFitAndTravelAnalytics === "function"
            ) {
                window.loadFitAndTravelAnalytics();
            }

            if (
                analytics === false &&
                typeof window.disableFitAndTravelAnalytics === "function"
            ) {
                window.disableFitAndTravelAnalytics();
            }
        };

        const savedConsent = localStorage.getItem(STORAGE_KEY);

        if (!savedConsent) {
            showBanner();
        }

        acceptButton.addEventListener("click", () => {
            saveConsent(true);
        });

        rejectButton.addEventListener("click", () => {
            saveConsent(false);
        });

        settingsButton.addEventListener("click", () => {
            showBanner();
        });
    })();
</script>

---
const { item, category, location = "gear" } = Astro.props;

const utmContent = `${category}_${item.title}`
    .toLowerCase()
    .replace(/[^a-z0-9äöüß]+/g, "_")
    .replace(/^_|_$/g, "");

const url = new URL(item.href);

url.searchParams.set("utm_source", "blog");
url.searchParams.set("utm_medium", "gear");
url.searchParams.set("utm_campaign", "direct_links");
url.searchParams.set("utm_content", utmContent);

const trackedHref = url.toString();

const rel = item.affiliate
    ? "sponsored noopener noreferrer"
    : "noopener noreferrer";
---

<a
    href={trackedHref}
    target="_blank"
    rel={rel}
    data-gear-link
    data-label={item.title}
    data-merchant={item.merchant}
    data-affiliate={String(item.affiliate)}
    data-location={location}
    class="group block rounded-2xl border border-slate-200 bg-white p-5 text-slate-900 transition-all duration-200 ease-out hover:-translate-y-1 hover:border-pink-300/60 hover:shadow-2xl dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:border-pink-300/30"
>
    {
        item.featured && (
            <div class="mb-3">
                <span class="inline-block rounded-full bg-pink-500 px-3 py-1 text-xs font-bold text-white shadow-sm">
                    ⭐ Top Empfehlung
                </span>
            </div>
        )
    }

    <div class="mb-2 text-lg font-bold">
        {item.title}
    </div>

    <div class="mb-3 flex flex-wrap gap-2">
        {
            item.merchant && (
                <span class="rounded-full bg-blue-100 px-2 py-1 text-[11px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                    {item.merchant}
                </span>
            )
        }

        {
            item.affiliate && (
                <span class="rounded-full bg-yellow-100 px-2 py-1 text-[11px] font-semibold text-yellow-800 dark:bg-yellow-500/20 dark:text-yellow-300">
                    Affiliate-Link
                </span>
            )
        }
    </div>

    {
        item.badges?.length > 0 && (
            <div class="mb-3 flex flex-wrap gap-2">
                {item.badges.map((badge) => (
                    <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 transition-colors duration-200 group-hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-100 dark:group-hover:bg-slate-600">
                        {badge}
                    </span>
                ))}
            </div>
        )
    }

    <p class="mb-4 leading-relaxed text-slate-600 dark:text-slate-300">
        {item.description}
    </p>

    {
        item.reason && (
            <div class="mb-4 rounded-xl bg-slate-50 p-3 text-sm leading-relaxed text-slate-700 dark:bg-slate-900/60 dark:text-slate-300">
                <span class="font-bold text-slate-900 dark:text-white">
                    Warum interessant:
                </span>{" "}
                {item.reason}
            </div>
        )
    }

    <div
        class="font-semibold text-blue-600 transition-transform duration-200 group-hover:translate-x-0.5 dark:text-blue-400"
    >
        {item.merchant ? `Bei ${item.merchant} ansehen →` : "Empfehlung ansehen →"}
    </div>
</a>

---
const pathname = Astro.url.pathname;

const linkClass = (path) =>
    `block px-4 py-2 md:inline hover:text-blue-300 transition-colors ${
        pathname === path ? "underline font-bold" : ""
    }`;
---

<header
    class="relative flex items-center justify-between bg-slate-900 px-4 py-4 text-white shadow-lg"
>
    <div class="text-xl font-extrabold tracking-tight">
        <a href="/" class="transition-colors hover:text-blue-300">
            Fit & Travel
        </a>
    </div>

    <nav class="hidden items-center space-x-6 text-lg font-semibold md:flex">
        <a href="/" class={linkClass("/")}>Home</a>
        <a href="/blog" class={linkClass("/blog")}>Blog</a>
        <a href="/about" class={linkClass("/about")}>Über</a>
        <a href="/kontakt" class={linkClass("/kontakt")}>Kontakt</a>

        <button
            id="desktop-dark-mode-toggle"
            data-theme-toggle
            type="button"
            class="rounded px-2 py-1 transition hover:bg-slate-800"
            aria-label="Dark Mode umschalten"
        >
            ☀️ Light
        </button>
    </nav>

    <button
        id="mobile-menu-button"
        type="button"
        class="ml-2 md:hidden"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
    >
        <svg
            width="28"
            height="28"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 8h20M4 16h20"></path>
        </svg>
    </button>

    <div
        id="mobile-menu"
        class="absolute left-0 top-full z-50 hidden w-full flex-col items-center space-y-2 bg-slate-900 py-4 shadow-lg md:hidden"
    >
        <a href="/" class={linkClass("/")}>Home</a>
        <a href="/blog" class={linkClass("/blog")}>Blog</a>
        <a href="/about" class={linkClass("/about")}>Über</a>
        <a href="/kontakt" class={linkClass("/kontakt")}>Kontakt</a>

        <button
            id="mobile-dark-mode-toggle"
            data-theme-toggle
            type="button"
            class="rounded px-2 py-1 transition hover:bg-slate-800"
            aria-label="Dark Mode umschalten"
        >
            ☀️ Light
        </button>
    </div>
</header>

<script>
    const menuButton = document.querySelector("#mobile-menu-button");
    const mobileMenu = document.querySelector("#mobile-menu");

    menuButton?.addEventListener("click", () => {
        const isOpen = !mobileMenu?.classList.contains("hidden");

        mobileMenu?.classList.toggle("hidden");
        mobileMenu?.classList.toggle("flex");

        menuButton.setAttribute("aria-expanded", String(!isOpen));
    });

    const toggleDarkMode = () => {
        const isDark = document.documentElement.classList.toggle("dark");

        localStorage.setItem("theme", isDark ? "dark" : "light");

        updateThemeButtons();
    };

    const updateThemeButtons = () => {
        const isDark = document.documentElement.classList.contains("dark");

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.textContent = isDark ? "🌙 Dark" : "☀️ Light";
        });
    };

    updateThemeButtons();

    document
        .querySelector("#desktop-dark-mode-toggle")
        ?.addEventListener("click", toggleDarkMode);

    document
        .querySelector("#mobile-dark-mode-toggle")
        ?.addEventListener("click", toggleDarkMode);
</script>

---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import RecommendationsSection from "../components/RecommendationsSection.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latestPosts = posts.slice(0, 3);
const byId = Object.fromEntries(posts.map((post) => [post.id, post]));

const fitnessPicks = [
    "hotelworkout",
    "fit-auf-langen-reisen-bewegung-flugzeug-flughafen-ankunft",
    "top-5-fitness-gadgets-fuer-unterwegs",
]
    .map((id) => byId[id])
    .filter(Boolean);

const travelPicks = [
    "phuket-fitness-muay-thai-aktive-urlaubstipps",
    "reiseziele",
]
    .map((id) => byId[id])
    .filter(Boolean);

const cardClasses =
    "group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800";
---

<Layout
    title="Fit & Travel | Fitness auf Reisen, Thailand & Travel Tipps"
    description="Fitness auf Reisen, Hotel-Workouts, Thailand-Tipps und praktische Travel Essentials: Fit & Travel verbindet aktive Reisen mit einfachen Workouts und hilfreichen Empfehlungen."
    canonical="https://fitandtravelblog.de/"
>
    <Header />
    <Hero />

    <main>
        <section class="bg-white px-4 py-16 dark:bg-slate-950">
            <div class="mx-auto max-w-6xl">
                <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                            Neu im Blog
                        </p>
                        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 md:text-4xl dark:text-white">
                            Aktuelle Fitness- &amp; Travel-Tipps
                        </h2>
                        <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
                            Neue Ideen für aktive Reisen, kurze Workouts unterwegs und praktische Reise-Essentials.
                        </p>
                    </div>

                    <a
                        href="/blog/"
                        class="font-semibold text-blue-600 hover:underline dark:text-blue-400"
                    >
                        Alle Artikel ansehen →
                    </a>
                </div>

                <div class="grid gap-6 md:grid-cols-3">
                    {latestPosts.map((post) => (
                        <article class={cardClasses}>
                            <a href={`/blog/${post.id}/`} class="block h-full">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    loading="lazy"
                                    class="h-48 w-full object-cover"
                                />
                                <div class="p-5">
                                    <div class="text-sm font-semibold text-blue-600 dark:text-blue-400">
                                        {post.data.category}
                                    </div>
                                    <h3 class="mt-2 text-xl font-bold text-slate-900 transition group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                                        {post.data.title}
                                    </h3>
                                    <p class="mt-3 line-clamp-3 leading-relaxed text-slate-600 dark:text-slate-300">
                                        {post.data.summary}
                                    </p>
                                    <span class="mt-4 inline-block font-semibold text-blue-600 dark:text-blue-400">
                                        Artikel lesen →
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="bg-slate-50 px-4 py-16 dark:bg-slate-900">
            <div class="mx-auto max-w-6xl">
                <div class="mb-8">
                    <p class="text-sm font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                        Fitness unterwegs
                    </p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-900 md:text-4xl dark:text-white">
                        Fit bleiben – auch ohne klassisches Gym
                    </h2>
                    <p class="mt-3 max-w-3xl leading-relaxed text-slate-600 dark:text-slate-300">
                        Hotel-Workouts, Bewegung auf langen Reisetagen und kompaktes Equipment: hier findest du einfache Wege, auch unterwegs aktiv zu bleiben.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-3">
                    {fitnessPicks.map((post) => (
                        <article class={cardClasses}>
                            <a href={`/blog/${post.id}/`} class="block h-full p-5">
                                <h3 class="text-xl font-bold text-slate-900 transition group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                                    {post.data.title}
                                </h3>
                                <p class="mt-3 line-clamp-4 leading-relaxed text-slate-600 dark:text-slate-300">
                                    {post.data.summary}
                                </p>
                                <span class="mt-4 inline-block font-semibold text-blue-600 dark:text-blue-400">
                                    Mehr erfahren →
                                </span>
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="bg-white px-4 py-16 dark:bg-slate-950">
            <div class="mx-auto max-w-6xl">
                <div class="mb-8">
                    <p class="text-sm font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                        Thailand &amp; aktive Reiseziele
                    </p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-900 md:text-4xl dark:text-white">
                        Reisen, entdecken und aktiv bleiben
                    </h2>
                    <p class="mt-3 max-w-3xl leading-relaxed text-slate-600 dark:text-slate-300">
                        Thailand ist ein Schwerpunkt von Fit &amp; Travel. Dazu kommen weitere Reiseziele, an denen Bewegung, Natur und Abenteuer besonders gut zusammenpassen.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    {travelPicks.map((post) => (
                        <article class={cardClasses}>
                            <a href={`/blog/${post.id}/`} class="grid h-full gap-0 sm:grid-cols-[180px_1fr]">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    loading="lazy"
                                    class="h-48 w-full object-cover sm:h-full"
                                />
                                <div class="p-5">
                                    <h3 class="text-xl font-bold text-slate-900 transition group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                                        {post.data.title}
                                    </h3>
                                    <p class="mt-3 line-clamp-4 leading-relaxed text-slate-600 dark:text-slate-300">
                                        {post.data.summary}
                                    </p>
                                    <span class="mt-4 inline-block font-semibold text-blue-600 dark:text-blue-400">
                                        Reisetipp lesen →
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <RecommendationsSection />
    </main>
</Layout>

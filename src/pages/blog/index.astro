---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const preferredCategoryOrder = ["Fitness", "Reisen", "Gear & Essentials"];
const availableCategories = new Set(posts.map((post) => post.data.category));
const categories = preferredCategoryOrder.filter((category) =>
    availableCategories.has(category),
);
---

<Layout
    title="Fitness & Travel Blog | Tipps für Reisen & Training"
    description="Entdecke Tipps rund um Fitness auf Reisen, Hotel-Workouts, Travel Essentials und praktische Empfehlungen für unterwegs."
    canonical="https://fitandtravelblog.de/blog"
>
    <Header />

    <main class="min-h-screen bg-slate-50 px-4 py-12 dark:bg-slate-900">
        <section class="mx-auto max-w-6xl">
            <header class="mb-10 text-center">
                <h1
                    class="text-3xl font-extrabold text-slate-900 md:text-5xl dark:text-white"
                >
                    Fit &amp; Travel Blog
                </h1>

                <p
                    class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300"
                >
                    Fitness unterwegs, praktische Travel Essentials und Tipps
                    für entspannteres Reisen.
                </p>
            </header>

            <div
                class="mb-8 flex flex-wrap justify-center gap-2"
                aria-label="Blogbeiträge nach Kategorie filtern"
            >
                <button
                    type="button"
                    class="category-filter rounded-full border border-blue-600 bg-white px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-50 aria-pressed:border-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white dark:bg-slate-800 dark:text-blue-300 dark:hover:bg-slate-700"
                    data-category-filter="all"
                    aria-pressed="true"
                >
                    Alle
                </button>

                {
                    categories.map((category) => (
                        <button
                            type="button"
                            class="category-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-500 hover:text-blue-700 aria-pressed:border-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300"
                            data-category-filter={category}
                            aria-pressed="false"
                        >
                            {category}
                        </button>
                    ))
                }
            </div>

            <p id="blog-filter-status" class="sr-only" aria-live="polite"></p>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    posts.map((post) => (
                        <article
                            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800"
                            data-blog-card
                            data-category={post.data.category}
                        >
                            <a href={`/blog/${post.id}`} class="block">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    loading="lazy"
                                    class="h-52 w-full object-cover"
                                />

                                <div class="p-5">
                                    <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                                        <span>{post.data.category}</span>

                                        <span aria-hidden="true">•</span>

                                        <time
                                            datetime={post.data.date.toISOString()}
                                        >
                                            {post.data.date.toLocaleDateString(
                                                "de-DE",
                                                {
                                                    day: "2-digit",
                                                    month: "2-digit",
                                                    year: "numeric",
                                                },
                                            )}
                                        </time>
                                    </div>

                                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">
                                        {post.data.title}
                                    </h2>

                                    <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">
                                        {post.data.summary}
                                    </p>

                                    <span class="mt-5 inline-block font-semibold text-blue-600 dark:text-blue-400">
                                        Artikel lesen →
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>
    </main>

    <script>
        const filterButtons =
            document.querySelectorAll<HTMLButtonElement>(
                "[data-category-filter]",
            );
        const blogCards =
            document.querySelectorAll<HTMLElement>("[data-blog-card]");
        const status = document.querySelector<HTMLElement>(
            "#blog-filter-status",
        );

        filterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const selectedCategory = button.dataset.categoryFilter ?? "all";
                let visibleCount = 0;

                filterButtons.forEach((filterButton) => {
                    filterButton.setAttribute(
                        "aria-pressed",
                        String(filterButton === button),
                    );
                });

                blogCards.forEach((card) => {
                    const isVisible =
                        selectedCategory === "all" ||
                        card.dataset.category === selectedCategory;

                    card.hidden = !isVisible;

                    if (isVisible) {
                        visibleCount += 1;
                    }
                });

                if (status) {
                    const categoryLabel =
                        selectedCategory === "all"
                            ? "allen Kategorien"
                            : selectedCategory;

                    status.textContent =
                        visibleCount +
                        " Beiträge aus " +
                        categoryLabel +
                        " angezeigt.";
                }
            });
        });
    </script>
</Layout>

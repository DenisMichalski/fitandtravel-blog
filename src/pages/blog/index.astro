---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
    title="Fitness & Travel Blog | Tipps für Reisen & Training"
    description="Entdecke Tipps rund um Fitness auf Reisen, Hotel-Workouts, Travel Essentials und praktische Empfehlungen für unterwegs."
    canonical="https://fitandtravelblog.de/blog"
>
    <Header />

    <main class="min-h-screen bg-slate-50 px-4 py-12 dark:bg-slate-900">
        <section class="mx-auto max-w-6xl">
            <header class="mb-10 text-center">
                <h1
                    class="text-3xl font-extrabold text-slate-900 md:text-5xl dark:text-white"
                >
                    Fit &amp; Travel Blog
                </h1>

                <p
                    class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300"
                >
                    Fitness unterwegs, praktische Travel Essentials und Tipps
                    für entspannteres Reisen.
                </p>
            </header>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    posts.map((post) => (
                        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
                            <a href={`/blog/${post.id}`} class="block">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    loading="lazy"
                                    class="h-52 w-full object-cover"
                                />

                                <div class="p-5">
                                    <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                                        <span>{post.data.category}</span>

                                        <span aria-hidden="true">•</span>

                                        <time
                                            datetime={post.data.date.toISOString()}
                                        >
                                            {post.data.date.toLocaleDateString(
                                                "de-DE",
                                                {
                                                    day: "2-digit",
                                                    month: "2-digit",
                                                    year: "numeric",
                                                },
                                            )}
                                        </time>
                                    </div>

                                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">
                                        {post.data.title}
                                    </h2>

                                    <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">
                                        {post.data.summary}
                                    </p>

                                    <span class="mt-5 inline-block font-semibold text-blue-600 dark:text-blue-400">
                                        Artikel lesen →
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((post) => ({
        params: {
            slug: post.id.replace(/\.md$/, ""),
        },
        props: {
            post,
        },
    }));
}

const { post } = Astro.props;

const { Content } = await render(post);

const allPosts = (await getCollection("blog"))
    .filter((candidate) => candidate.id !== post.id)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sameCategoryPosts = allPosts.filter(
    (candidate) => candidate.data.category === post.data.category,
);
const otherPosts = allPosts.filter(
    (candidate) => candidate.data.category !== post.data.category,
);

const relatedPosts = [...sameCategoryPosts, ...otherPosts].slice(0, 3);

const canonical = `https://fitandtravelblog.de/blog/${post.id.replace(/\.md$/, "")}/`;

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.summary,
    image: [post.data.image],
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonical,
    },
    author: {
        "@type": "Person",
        name: "Denis Michalski",
        url: "https://fitandtravelblog.de/about/",
    },
    publisher: {
        "@type": "Organization",
        name: "Fit & Travel",
        url: "https://fitandtravelblog.de/",
    },
};
---

<Layout
    title={`${post.data.title} | Fit & Travel`}
    description={post.data.summary}
    canonical={canonical}
    image={post.data.image}
>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <Header />

    <main class="min-h-screen bg-white px-4 py-10 dark:bg-slate-900">
        <article class="mx-auto max-w-3xl">
            <header class="mb-8">
                <div
                    class="mb-3 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400"
                >
                    <span>{post.data.category}</span>

                    <span aria-hidden="true">•</span>

                    <time datetime={post.data.date.toISOString()}>
                        {
                            post.data.date.toLocaleDateString("de-DE", {
                                day: "2-digit",
                                month: "2-digit",
                                year: "numeric",
                            })
                        }
                    </time>

                    {
                        post.data.updated && (
                            <>
                                <span aria-hidden="true">•</span>
                                <span>
                                    Aktualisiert am{" "}
                                    <time datetime={post.data.updated.toISOString()}>
                                        {post.data.updated.toLocaleDateString("de-DE", {
                                            day: "2-digit",
                                            month: "2-digit",
                                            year: "numeric",
                                        })}
                                    </time>
                                </span>
                            </>
                        )
                    }
                </div>

                <h1
                    class="text-3xl font-extrabold leading-tight text-slate-900 md:text-5xl dark:text-white"
                >
                    {post.data.title}
                </h1>

                <p
                    class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300"
                >
                    {post.data.summary}
                </p>

                <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="mt-8 w-full rounded-3xl object-cover shadow-lg"
                />
            </header>

            <div
                class="prose prose-slate max-w-none dark:prose-invert
               prose-headings:font-bold
               prose-a:text-blue-600
               dark:prose-a:text-blue-400"
            >
                <Content />
            </div>
            {
                relatedPosts.length > 0 && (
                    <aside
                        class="mt-14 border-t border-slate-200 pt-10 dark:border-slate-700"
                        aria-labelledby="related-posts-title"
                    >
                        <div class="mb-6 flex items-end justify-between gap-4">
                            <div>
                                <p class="text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-400">
                                    Weiterlesen
                                </p>
                                <h2
                                    id="related-posts-title"
                                    class="mt-1 text-2xl font-bold text-slate-900 dark:text-white"
                                >
                                    Passende Artikel
                                </h2>
                            </div>

                            <a
                                href="/blog/"
                                class="hidden text-sm font-semibold text-blue-600 hover:underline sm:inline dark:text-blue-400"
                            >
                                Alle Artikel →
                            </a>
                        </div>

                        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                            {relatedPosts.map((relatedPost) => (
                                <a
                                    href={`/blog/${relatedPost.id.replace(/\.md$/, "")}/`}
                                    class="group overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-700 dark:bg-slate-800"
                                >
                                    <img
                                        src={relatedPost.data.image}
                                        alt=""
                                        loading="lazy"
                                        class="h-36 w-full object-cover"
                                    />

                                    <div class="p-4">
                                        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                                            <span>{relatedPost.data.category}</span>
                                            <span aria-hidden="true">•</span>
                                            <time datetime={relatedPost.data.date.toISOString()}>
                                                {relatedPost.data.date.toLocaleDateString(
                                                    "de-DE",
                                                    {
                                                        day: "2-digit",
                                                        month: "2-digit",
                                                        year: "numeric",
                                                    },
                                                )}
                                            </time>
                                        </div>

                                        <h3 class="font-bold leading-snug text-slate-900 transition group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                                            {relatedPost.data.title}
                                        </h3>

                                        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                                            {relatedPost.data.summary}
                                        </p>
                                    </div>
                                </a>
                            ))}
                        </div>

                        <a
                            href="/blog/"
                            class="mt-6 inline-block text-sm font-semibold text-blue-600 hover:underline sm:hidden dark:text-blue-400"
                        >
                            Alle Artikel →
                        </a>
                    </aside>
                )
            }
        </article>
    </main>
</Layout>
